      ],
      "parameters": {
        "jsCode": "const id = String($('Webhook').first().json.query.user_id ?? '');\nif (!/^[0-9a-f-]{36}$/i.test(id)) throw new Error('user_id query param must be a UUID');\nreturn [{ json: { user_id: id } }];"
      }
    },
    {
