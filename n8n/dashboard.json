    {
      "id": "d983293a-db2d-48c8-84da-b2eda6af9ee7",
      "name": "Assemble",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "jsCode": "// One payload for the dashboard (and the scheduler LLM): profile, calendar, transactions, and cashflow derived from them.\nconst rows = (node) => $(node).all().map((i) => i.json).filter((r) => r.user_id);\nconst pick = (r, keys) => Object.fromEntries(keys.map((k) => [k, r[k] ?? null]));\n\nconst [user = null] = rows('Get user').map((r) => pick(r, ['user_id', 'job', 'mode', 'hourly_pay', 'preferences', 'updated_at']));\nconst events = rows('Get calendar').map((r) => pick(r, ['title', 'start', 'end', 'location', 'rrule'])).sort((a, b) => String(a.start).localeCompare(String(b.start)));\nconst transactions = rows('Get transactions').map((r) => pick(r, ['date', 'description', 'amount', 'category', 'balance'])).sort((a, b) => String(a.date).localeCompare(String(b.date)));\n\n// shortcut: a \"bill\" is any outgoing with the same description in 2+ months; balance is the latest row's Balance column (null if the CSV had none).\nconst byDesc = {};\nfor (const t of transactions) if (t.amount < 0 && t.description) (byDesc[t.description.toLowerCase()] ??= []).push(t);\nconst bills = Object.values(byDesc)\n  .filter((ts) => new Set(ts.map((t) => t.date.slice(0, 7))).size >= 2)\n  .map((ts) => { const last = ts.at(-1); return { name: last.description, amount: -last.amount, day: Number(last.date.slice(8, 10)) }; })\n  .sort((a, b) => a.day - b.day);\nconst latest = transactions.findLast((t) => t.balance != null);\n\nreturn [{ json: { user, events, transactions, cashflow: { balance: latest?.balance ?? null, bills } } }];\n"
      }
    },
    {
      "id": "830d78e0-9aa2-4cc9-b666-67287538346b",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
